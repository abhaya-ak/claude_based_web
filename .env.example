# ==============================================================================
# ScamShield Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# In production, these are injected via AWS Systems Manager Parameter Store or ECS.
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-django-secret-key-placeholder-at-least-50-chars-long
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
TRUSTED_PROXY_HOPS=0

# Database Configuration (PostgreSQL)
DB_NAME=scamshield
DB_USER=scamshield_user
DB_PASSWORD=scamshield_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Security & Cryptographic Keys (>= 32 chars in production)
JWT_SIGNING_KEY=dev-jwt-signing-key-placeholder-at-least-32-chars
HMAC_IP_SALT=dev-hmac-ip-salt-placeholder-at-least-32-chars
INDICATOR_HMAC_KEY=dev-indicator-hmac-key-placeholder-32-chars

# AWS Configuration (Local development / mocks)
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_EC2_METADATA_DISABLED=true
# AWS_ENDPOINT_URL=http://localhost:4566

# Operational & Telemetry Flags
METRICS_ENABLED=False

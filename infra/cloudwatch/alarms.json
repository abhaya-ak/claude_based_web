[
  {
    "AlarmName": "scamshield-ec2-high-cpu",
    "AlarmDescription": "EC2 ASG CPU utilization exceeds 80% for 10 minutes",
    "Namespace": "AWS/EC2",
    "MetricName": "CPUUtilization",
    "Dimensions": [
      {
        "Name": "AutoScalingGroupName",
        "Value": "scamshield-asg"
      }
    ],
    "Statistic": "Average",
    "Period": 300,
    "EvaluationPeriods": 2,
    "Threshold": 80.0,
    "ComparisonOperator": "GreaterThanThreshold",
    "AlarmActions": [
      "arn:aws:sns:ap-southeast-1:123456789012:scamshield-ops-alerts"
    ]
  },
  {
